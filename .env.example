# Local development defaults. Change credentials before exposing services.
MYSQL_ROOT_PASSWORD=db_dev
MYSQL_DATABASE=novel
MYSQL_PORT=3306
MYSQL_USER=root

REDIS_PORT=6379
REDIS_PASSWORD=

# Backends running on the host connect through the published ports above.
BACKEND_MYSQL_HOST=127.0.0.1
BACKEND_REDIS_HOST=127.0.0.1
GO_PORT=8081
